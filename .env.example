# Copie para .env e ajuste. O .env não é versionado.

# Ambiente: development habilita comandos perigosos, como o down das migrations.
APP_ENV=development

# Banco da aplicação.
DATABASE_URL=postgres://inscreve:inscreve@localhost:5432/inscreve?sslmode=disable

# Servidor usado pelos testes. Cada teste cria e apaga o próprio banco nele,
# então o usuário precisa da permissão CREATEDB.
TEST_DATABASE_URL=postgres://inscreve:inscreve@localhost:5432/postgres?sslmode=disable
